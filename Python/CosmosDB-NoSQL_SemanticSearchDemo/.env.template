# Copy to .env in the SAMPLE ROOT for local use. Never commit .env.
# Process environment variables take precedence. App Service uses app settings.
COSMOS_URI=https://YOUR-COSMOS-ACCOUNT.documents.azure.com:443/
COSMOS_DB_DATABASE=YOUR-EXISTING-DATABASE
AZURE_AI_INFERENCE_ENDPOINT=https://YOUR-INFERENCE-ENDPOINT.dbinference.azure.com

# Optional. Full text search/ranking and preembedded loading do not need OpenAI.
# Use a deployment that emits 1536-dimensional embeddings.
# AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
# AZURE_OPENAI_API_VERSION=2024-02-01
# Prefer Entra auth. Set a key only if Entra authentication is not available.
# AZURE_OPENAI_API_KEY=

# Optional user-assigned managed identity; otherwise system identity/CLI is used.
# AZURE_CLIENT_ID=
